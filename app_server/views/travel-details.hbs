
<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
    <meta charset="UTF-8">
    <title>{{trip.name}} - Travlr Getaways</title>
    <link rel="stylesheet" href="/css/style.css" type="text/css">
</head>
<body>
    <div id="background">
        <div id="page">
            {{> header}}

            <div id="contents">
                <div class="box">
                    <div>
                        <div class="body">
                            <h1>{{trip.name}}</h1>

                            <div class="trip-details">
                                <img src="/images/{{trip.image}}"
                                     alt="{{trip.name}}">

                                <h2>Trip Information</h2>

                                <p><strong>Trip Code:</strong> {{trip.code}}</p>
                                <p><strong>Length:</strong> {{trip.length}}</p>
                                <p><strong>Start Date:</strong> {{trip.start}}</p>
                                <p><strong>Resort:</strong> {{trip.resort}}</p>
                                <p><strong>Price:</strong> {{trip.perPerson}}</p>

                                <h2>Description</h2>
                                {{{trip.description}}}

                                <p>
                                    <a href="/travel">Back to All Trips</a>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
                </div>
            </div>
            </div>
    </div>

    {{> footer}}
</body>
</html>